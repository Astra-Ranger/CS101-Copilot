# Flask shell backend
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=1

# Relative paths are resolved from the repository root by backend/main.py.
# The current static frontend uses this only through Flask's development-only
# /course_slide/... file mapping. The future backend should scan this directory
# when implementing GET /api/slides/<course_id>.
COURSE_SLIDE_ROOT=course_slide
COURSE_NOTES_PATH=backend/user_notes.json
COURSE_CHAT_HISTORY_PATH=backend/chat_conversations.json

# Qwen-v35 OpenAI-compatible chat endpoint.
QWEN_BASE_URL=http://10.10.4.99:2026/v1
QWEN_CHAT_COMPLETIONS_PATH=/chat/completions
QWEN_API_KEY=qwenv35
QWEN_MODEL=qwenv35
QWEN_ENABLE_THINKING=false

# DeepSeek fast model for routing, summaries, and chat titles.
DS_BASE_URL=http://10.10.4.99:2025/v1
DS_CHAT_COMPLETIONS_PATH=/chat/completions
DS_API_KEY=dsflash
DS_MODEL=dsflash
DS_ENABLE_THINKING=false

# RAG knowledge base.
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=cs101_course_markdown
EMBEDDING_MODEL=BAAI/bge-m3
