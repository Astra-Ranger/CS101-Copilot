# Flask shell backend
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=1

# Relative paths are resolved from the repository root by backend/main.py.
# The current static frontend uses this only through Flask's development-only
# /course_slide/... file mapping. The future backend should scan this directory
# when implementing GET /api/slides/<course_id>.
COURSE_SLIDE_ROOT=course_slide
COURSE_NOTES_PATH=backend/user_notes.json
COURSE_CHAT_HISTORY_PATH=backend/chat_conversations.json

# Model providers and per-task model selection live in backend/config/models.json
# and backend/config/model_tasks.json.

# RAG knowledge base.
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=cs101_course_markdown
EMBEDDING_MODEL=BAAI/bge-m3
